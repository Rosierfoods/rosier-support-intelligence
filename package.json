{
  "name": "rosier-support-intelligence",
  "version": "1.0.0",
  "private": true,
  "description": "Rosier Support Intelligence \u2014 AI customer support quality and insights platform for Rosier Foods",
  "scripts": {
    "init": "tsx scripts/init-env.ts",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "tsx scripts/local-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset-demo": "tsx scripts/seed.ts --reset",
    "db:clear-demo": "tsx scripts/seed.ts --clear-demo",
    "user:create": "tsx scripts/create-user.ts",
    "worker": "tsx scripts/worker.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "go-live": "tsx scripts/go-live.ts"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.1.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "lucide-react": "0.460.0",
    "next": "^16.3.8",
    "nodemailer": "^10.1.0",
    "pg": "8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "2.15.4",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.10",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.7",
    "embedded-postgres": "17.9.0-beta.16",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.8",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
